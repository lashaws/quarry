{
  "name": "quarry",
  "version": "0.1.0",
  "description": "A DataGrip-style Postgres client for the desktop",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "./run-tests.sh",
    "test:live": "./node_modules/.bin/esbuild test/live.ts --bundle --format=esm --platform=node --packages=external --tsconfig=tsconfig.test.json --log-level=warning --outfile=.test-out/live.mjs && node .test-out/live.mjs",
    "test:session": "./node_modules/.bin/esbuild test/session.live.ts --bundle --format=esm --platform=node --packages=external --alias:electron=./test/stubs/electron.ts --tsconfig=tsconfig.test.json --log-level=warning --outfile=.test-out/session.mjs && node .test-out/session.mjs",
    "test:all": "npm run test && npm run test:live && npm run test:session",
    "package": "npm run build && electron-builder --mac",
    "package:all": "npm run build && electron-builder --mac --linux --win"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "pg-cursor": "^2.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql-formatter": "^15.8.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "electron@44.0.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "author": "lashaws",
  "license": "MIT",
  "homepage": "https://github.com/lashaws/quarry",
  "repository": {
    "type": "git",
    "url": "https://github.com/lashaws/quarry.git"
  }
}
